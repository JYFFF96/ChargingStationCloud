<view class="charging-page">
  <view class="charge-hero">
    <view class="soc-ring"><text class="soc">{{soc}}</text><text class="pct">%</text></view>
    <view class="charge-state">{{statusText}}</view>
    <view class="pile-code" wx:if="{{pileCode}}">桩编号 {{pileCode}} / 枪 {{gunNo}}</view>
  </view>
  <view wx:if="{{error}}" class="tip">{{error}}</view>
  <view class="grid">
    <view><text>{{voltage}}</text><span>电压 V</span></view><view><text>{{current}}</text><span>电流 A</span></view><view><text>{{power}}</text><span>功率 kW</span></view>
    <view><text>{{energy}}</text><span>电量 kWh</span></view><view><text>{{minutes}}</text><span>已充 min</span></view><view><text>{{remaining}}</text><span>剩余 min</span></view>
    <view><text>{{temp}}</text><span>枪温 ℃</span></view><view><text>{{amount}}</text><span>金额 元</span></view><view><text>{{faultText}}</text><span>硬件故障</span></view>
  </view>
  <view class="billing"><view><span>当前计费</span><b>峰段</b></view><view><span>电费</span><b>4.00000 元/kWh</b></view><view><span>服务费</span><b>0.40000 元/kWh</b></view><view wx:if="{{transactionId}}"><span>流水号</span><b>{{transactionId}}</b></view></view>
  <button loading="{{busy}}" class="action {{charging||transactionId?'stop':'start'}}" bindtap="toggle">{{charging||transactionId?'停止充电':'启动充电'}}</button>
  <view class="tip">启动下发0x34，桩回复0x33；停止下发0x36，桩回复0x35；结束后桩上送0x3B，平台回复0x40。</view>
</view>

.charging-page{padding-bottom:30rpx}.charge-hero{background:linear-gradient(135deg,#00BFA5,#00897B);padding:45rpx 0 40rpx;text-align:center;color:#fff}.soc-ring{width:280rpx;height:280rpx;border:18rpx solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center}.soc{font-size:76rpx;font-weight:800}.pct{font-size:28rpx;margin-left:4rpx}.charge-state{margin-top:20rpx;font-size:28rpx}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:24rpx 28rpx}.grid view{background:#fff;border-radius:18rpx;padding:20rpx 8rpx;text-align:center;box-shadow:0 3rpx 12rpx rgba(0,0,0,.04)}.grid text{display:block;font-size:30rpx;font-weight:700;color:#333}.grid span{display:block;font-size:20rpx;color:#999;margin-top:6rpx}.billing{margin:20rpx 28rpx;background:#fff;border-radius:20rpx;padding:10rpx 22rpx}.billing view{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #f0f0f0}.billing view:last-child{border-bottom:0}.billing span{color:#777;font-size:24rpx}.billing b{font-size:24rpx;color:#333}.action{margin:26rpx 28rpx;border-radius:48rpx;color:#fff}.start{background:linear-gradient(135deg,#00BFA5,#00897B)}.stop{background:linear-gradient(135deg,#FF5252,#D32F2F)}.tip{margin:0 28rpx;color:#999;font-size:21rpx;line-height:1.7}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.06);
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.label {
  color: #86909c;
}

.value {
  color: #1f2329;
}

.online {
  color: #00a870;
  font-weight: 600;
}

.offline,
.error {
  color: #d54941;
}

.empty,
.error {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

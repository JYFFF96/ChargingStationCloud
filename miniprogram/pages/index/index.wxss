.page-wrap{padding-bottom:24rpx}.hero{background:linear-gradient(135deg,#00BFA5,#00897B);color:#fff;padding:34rpx 28rpx 28rpx}.hero-title{font-size:42rpx;font-weight:800}.hero-sub{font-size:24rpx;opacity:.82;margin-top:8rpx}.overview{display:flex;margin-top:32rpx}.overview view{flex:1;text-align:center;border-right:1rpx solid rgba(255,255,255,.2)}.overview view:last-child{border-right:0}.overview text{display:block;font-size:38rpx;font-weight:800}.overview span{font-size:21rpx;opacity:.82}.quick-card{margin:22rpx 28rpx;background:#fff;border-radius:24rpx;padding:24rpx 10rpx;display:flex;box-shadow:0 5rpx 18rpx rgba(0,0,0,.05)}.quick{flex:1;text-align:center;font-size:22rpx;color:#555}.qicon{width:72rpx;height:72rpx;line-height:72rpx;margin:0 auto 10rpx;border-radius:20rpx;background:#E0F7F4;color:#00A28C;font-size:32rpx;font-weight:700}.section-head{display:flex;justify-content:space-between;padding:8rpx 28rpx 14rpx;font-size:29rpx;font-weight:700}.refresh{font-size:24rpx;color:#00A28C;font-weight:500}.station-card{margin:0 28rpx 18rpx;background:#fff;border-radius:22rpx;padding:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05)}.station-top{display:flex;justify-content:space-between;align-items:flex-start}.station-name{font-size:29rpx;font-weight:700;color:#333}.station-id{font-size:22rpx;color:#999;margin-top:6rpx}.status{font-size:22rpx;padding:7rpx 16rpx;border-radius:18rpx}.online{background:#E8F5E9;color:#43A047}.offline{background:#f2f2f2;color:#999}.station-info{display:flex;gap:24rpx;font-size:23rpx;color:#666;margin:22rpx 0 18rpx}.gun-row{display:flex;justify-content:space-between;align-items:center}.gun-dot{padding:6rpx 16rpx;border-radius:18rpx;background:#E8F5E9;border:2rpx solid #43A047;color:#43A047;font-size:21rpx}.muted{font-size:21rpx;color:#aaa}.notice{margin:0 28rpx 18rpx;background:#fff;border-radius:18rpx;padding:24rpx;color:#888}.error{color:#e53935}
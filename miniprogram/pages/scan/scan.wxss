.scan-page{padding:90rpx 48rpx;text-align:center}.scan-box{width:420rpx;height:420rpx;border:6rpx solid #00BFA5;border-radius:28rpx;margin:0 auto 42rpx;position:relative;overflow:hidden;background:#eefbf9}.scan-line{position:absolute;left:0;right:0;height:6rpx;background:linear-gradient(90deg,transparent,#00BFA5,transparent);animation:move 2s linear infinite}@keyframes move{0%{top:0}50%{top:100%}100%{top:0}}.scan-title{font-size:34rpx;font-weight:700;color:#333}.scan-desc{font-size:24rpx;color:#888;line-height:1.7;margin:18rpx 0 36rpx}.scan-btn{background:linear-gradient(135deg,#00BFA5,#00897B);color:#fff;border-radius:48rpx}.result{margin-top:30rpx;background:#E8F5E9;color:#00897B;border-radius:18rpx;padding:24rpx;font-size:24rpx;word-break:break-all}
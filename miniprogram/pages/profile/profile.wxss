.profile-head{background:linear-gradient(135deg,#00BFA5,#00897B);padding:52rpx 20rpx 44rpx;text-align:center;color:#fff}.avatar{width:120rpx;height:120rpx;border-radius:50%;background:rgba(255,255,255,.2);margin:0 auto 16rpx;display:flex;align-items:center;justify-content:center;font-size:52rpx;font-weight:700}.name{font-size:34rpx;font-weight:700}.sub{font-size:22rpx;opacity:.8;margin-top:8rpx}.balance{margin:22rpx 28rpx;background:#fff;border-radius:22rpx;padding:24rpx;display:flex;justify-content:space-between;align-items:center}.balance span{display:block;font-size:22rpx;color:#999}.balance b{display:block;font-size:34rpx;color:#00A28C;margin-top:5rpx}.menu{margin:0 28rpx;background:#fff;border-radius:22rpx;overflow:hidden}.menu view{display:flex;justify-content:space-between;padding:26rpx 24rpx;border-bottom:1rpx solid #f0f0f0;font-size:27rpx;color:#333}.menu text{color:#bbb;font-size:34rpx}.tip{margin:24rpx 32rpx;font-size:21rpx;color:#999;line-height:1.7}
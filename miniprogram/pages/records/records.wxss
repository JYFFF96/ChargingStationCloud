.page{padding:24rpx;background:#f5f7fa;min-height:100vh}.head{display:flex;justify-content:space-between;align-items:center;font-size:36rpx;font-weight:700;margin-bottom:20rpx}.card{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:18rpx;box-shadow:0 4rpx 18rpx rgba(0,0,0,.05)}.title{font-size:30rpx;font-weight:700;display:flex;justify-content:space-between}.state{color:#00a870;font-size:24rpx}.row{display:flex;justify-content:space-between;margin:18rpx 0;color:#666;font-size:24rpx}.mono{font-family:monospace;font-size:20rpx}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.grid view{background:#f7f9fb;border-radius:14rpx;padding:18rpx;text-align:center}.grid b{display:block;font-size:28rpx}.grid span{display:block;color:#999;font-size:20rpx;margin-top:6rpx}.msg{background:#fff;border-radius:16rpx;padding:28rpx;color:#666}.error{color:#d54941}

<view class="page"><view class="head"><text>充电记录</text><button size="mini" loading="{{loading}}" bindtap="load">刷新</button></view><view wx:if="{{error}}" class="msg error">{{error}}</view><view wx:if="{{!loading&&!items.length}}" class="msg">暂无充电记录</view><block wx:for="{{items}}" wx:key="transaction_id"><view class="card"><view class="title">{{item.pile_code}} / 枪 {{item.gun_no||'01'}}<text class="state">{{item.status}}</text></view><view class="row"><text>交易流水号</text><text class="mono">{{item.transaction_id}}</text></view><view class="grid"><view><b>{{item.soc_pct===undefined?'-':item.soc_pct}}</b><span>SOC %</span></view><view><b>{{item.energy_kwh===undefined?'-':item.energy_kwh}}</b><span>电量 kWh</span></view><view><b>{{item.amount_yuan===undefined?'-':item.amount_yuan}}</b><span>金额 元</span></view></view></view></block></view>

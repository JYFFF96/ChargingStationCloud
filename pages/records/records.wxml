<view class="container">
  <view class="header"><view><view class="title">充电记录</view><view class="muted">最近的模拟充电记录</view></view><text wx:if="{{records.length}}" class="clear" bindtap="clearRecords">清空</text></view>
  <view wx:if="{{!records.length}}" class="empty card"><view class="empty-icon">⚡</view><view class="empty-title">暂无充电记录</view><view class="muted">完成一次模拟充电后会显示在这里</view></view>
  <view wx:else>
    <view wx:for="{{records}}" wx:key="id" class="record card">
      <view class="top"><view><view class="device">{{item.deviceId}}</view><view class="muted">{{item.time}} · {{item.gunId}}号枪</view></view><view class="money">¥{{item.amount}}</view></view>
      <view class="bottom"><text>{{item.energy}} kWh</text><text>{{item.duration}}</text><text class="done-tag">已完成</text></view>
    </view>
  </view>
</view>
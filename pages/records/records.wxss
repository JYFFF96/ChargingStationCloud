.header { display:flex; align-items:center; justify-content:space-between; padding:20rpx 4rpx 28rpx; }
.title { font-size:44rpx; font-weight:800; }
.clear { color:#d35a53; font-size:25rpx; }
.empty { text-align:center; padding:90rpx 30rpx; }
.empty-icon { font-size:56rpx; margin-bottom:18rpx; }
.empty-title { font-size:30rpx; font-weight:650; margin-bottom:8rpx; }
.record { margin-bottom:22rpx; }
.top { display:flex; justify-content:space-between; align-items:flex-start; }
.device { font-size:30rpx; font-weight:700; margin-bottom:6rpx; }
.money { font-size:36rpx; font-weight:750; }
.bottom { display:flex; align-items:center; gap:28rpx; border-top:1rpx solid #edf1ef; margin-top:24rpx; padding-top:22rpx; color:#7d8783; font-size:24rpx; }
.done-tag { margin-left:auto; color:#15955f; background:#eaf8f1; padding:7rpx 16rpx; border-radius:18rpx; }

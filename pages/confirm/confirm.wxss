.status-card { margin-top:18rpx; }
.online { color:#15955f; font-size:26rpx; font-weight:650; }
.dot { display:inline-block; width:14rpx; height:14rpx; border-radius:50%; background:#19b875; margin-right:12rpx; }
.device-name { font-size:40rpx; font-weight:750; margin:18rpx 0 8rpx; }
.detail { margin-top:26rpx; }
.row { display:flex; justify-content:space-between; align-items:center; padding:26rpx 0; border-bottom:1rpx solid #edf1ef; font-size:28rpx; }
.row:last-child { border-bottom:0; }
.label { color:#7b8581; }
.tip { margin:26rpx 8rpx 0; color:#8b9490; font-size:24rpx; line-height:1.6; }
